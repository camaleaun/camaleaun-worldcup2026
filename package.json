{
  "name": "camaleaun-worldcup2026",
  "version": "1.0.0",
  "private": true,
  "description": "FIFA World Cup 2026™ schedule Gutenberg block",
  "scripts": {
    "build":          "wp-scripts build",
    "start":          "wp-scripts start",
    "check-types":    "tsc --noEmit",
    "lint":           "wp-scripts lint-js",
    "playground":     "npm run build && npx @wp-playground/cli@latest server --blueprint=blueprints/blueprint-local.json",
    "playground:web": "npm run build && npx @wp-playground/cli@latest server --blueprint=blueprints/blueprint.json"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0",
    "@types/react":       "^18.3.0",
    "@types/react-dom":   "^18.3.0",
    "typescript":         "^5.4.0"
  }
}
