{
  "compilerOptions": {
    "target":                   "ES2020",
    "lib":                      ["ES2020", "DOM"],
    "jsx":                      "react-jsx",
    "jsxImportSource":          "react",
    "module":                   "ESNext",
    "moduleResolution":         "bundler",
    "strict":                   true,
    "noEmit":                   true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop":          true,
    "resolveJsonModule":        true,
    "baseUrl":                  ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build"]
}
